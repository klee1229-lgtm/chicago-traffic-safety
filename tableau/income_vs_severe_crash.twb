      <aliases enabled='yes' />
      <column caption='Alignment' datatype='string' name='[ALIGNMENT]' role='dimension' type='nominal' />
      <column caption='Beat Of Occurrence' datatype='real' name='[BEAT_OF_OCCURRENCE]' role='measure' type='quantitative' />
      <column caption='Crash Date' datatype='datetime' name='[CRASH_DATE]' role='dimension' type='ordinal' />
      <column caption='Crash Date Est I' datatype='string' name='[CRASH_DATE_EST_I]' role='dimension' type='nominal' />
      <column caption='Crash Day Of Week' datatype='integer' name='[CRASH_DAY_OF_WEEK]' role='dimension' type='quantitative' />
      <column caption='Crash Hour' datatype='integer' name='[CRASH_HOUR]' role='measure' type='quantitative' />
      <column caption='Crash Month' datatype='integer' name='[CRASH_MONTH]' role='dimension' type='quantitative' />
      <column caption='Crash Record Id' datatype='string' name='[CRASH_RECORD_ID]' role='dimension' type='nominal' />
      <column caption='Crash Type' datatype='string' name='[CRASH_TYPE]' role='dimension' type='nominal' />
      <column caption='POC Group' datatype='string' name='[Calculation_786441086222217217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pct_poc] &gt;= 0.6 THEN &quot;Higher % POC Communities&quot;&#13;&#10;ELSE &quot;Lower % POC Communities&quot;&#13;&#10;END' />
      </column>
      <column caption='Income Quartile Label' datatype='string' name='[Calculation_786441086225850370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [income_quartile] = 1 THEN &quot;Lowest Income&quot;&#13;&#10;ELSEIF [income_quartile] = 2 THEN &quot;Lower-Middle Income&quot;&#13;&#10;ELSEIF [income_quartile] = 3 THEN &quot;Upper-Middle Income&quot;&#13;&#10;ELSE &quot;Highest Income&quot;&#13;&#10;END' />
      </column>
      <column caption='Severe Crash Percentage' datatype='real' name='[Calculation_811492358840074240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [severe_crash] = TRUE THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([CRASH_RECORD_ID])' />
      </column>
      <column caption='Total Crashes' datatype='integer' name='[Calculation_811492358842753025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([CRASH_RECORD_ID])' />
      </column>
      <column caption='Severe Crash Count' datatype='integer' name='[Calculation_811492358842904578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [severe_crash] = TRUE THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Crash Count by Speed Limit' datatype='integer' name='[Calculation_811492358855733251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [POSTED_SPEED_LIMIT] : COUNT([CRASH_RECORD_ID]) }' />
      </column>
      <column caption='Ped/Cyc Severe Crash Percentage' datatype='real' name='[Calculation_811492358857543684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [has_ped_cyc] = TRUE&#13;&#10;AND [severe_crash] = TRUE&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [has_ped_cyc] = TRUE&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
