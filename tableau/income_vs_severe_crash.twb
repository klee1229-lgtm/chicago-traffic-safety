            <column-instance column='[Calculation_811492358842753025]' derivation='User' name='[usr:Calculation_811492358842753025:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.1suxiqo0du9xpk192unzb1i2u601].[none:Calculation_786441086225850370:nk]' direction='ASC'>
