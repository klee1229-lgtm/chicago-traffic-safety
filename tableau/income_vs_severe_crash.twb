  <worksheets>
    <worksheet name='Income vs Severe Crash'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000'>Lower-income communities tend to experience higher severe crash percentages, while higher-income communities generally show lower crash severity rates.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='community_areas.geojson+ (Multiple Connections)' name='federated.1suxiqo0du9xpk192unzb1i2u601' />
          </datasources>
          <datasource-dependencies datasource='federated.1suxiqo0du9xpk192unzb1i2u601'>
            <column caption='Crash Record Id' datatype='string' name='[CRASH_RECORD_ID]' role='dimension' type='nominal' />
            <column caption='Income Quartile Label' datatype='string' name='[Calculation_786441086225850370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [income_quartile] = 1 THEN &quot;Lowest Income&quot;&#13;&#10;ELSEIF [income_quartile] = 2 THEN &quot;Lower-Middle Income&quot;&#13;&#10;ELSEIF [income_quartile] = 3 THEN &quot;Upper-Middle Income&quot;&#13;&#10;ELSE &quot;Highest Income&quot;&#13;&#10;END' />
            </column>
            <column caption='Severe Crash Percentage' datatype='real' name='[Calculation_811492358840074240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [severe_crash] = TRUE THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([CRASH_RECORD_ID])' />
            </column>
            <column caption='Total Crashes' datatype='integer' name='[Calculation_811492358842753025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([CRASH_RECORD_ID])' />
            </column>
            <column-instance column='[community]' derivation='Attribute' name='[attr:community:nk]' pivot='key' type='nominal' />
            <column-instance column='[pct_poc]' derivation='Avg' name='[avg:pct_poc:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pop_weighted_income]' derivation='Avg' name='[avg:pop_weighted_income:qk]' pivot='key' type='quantitative' />
            <column caption='Community' datatype='string' name='[community]' role='dimension' type='nominal' />
            <column datatype='integer' name='[income_quartile]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_786441086225850370]' derivation='None' name='[none:Calculation_786441086225850370:nk]' pivot='key' type='nominal' />
            <column-instance column='[community]' derivation='None' name='[none:community:nk]' pivot='key' type='nominal' />
            <column caption='Pct Poc' datatype='real' name='[pct_poc]' role='measure' type='quantitative' />
            <column caption='Pop Weighted Income' datatype='real' name='[pop_weighted_income]' role='measure' type='quantitative' />
            <column caption='Severe Crash' datatype='boolean' name='[severe_crash]' role='dimension' type='nominal' />
